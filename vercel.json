{
  "framework": "nextjs",
  "root": "frontend",
  "buildCommand": "cd frontend && npm run build",
  "outputDirectory": "frontend/.next",
  "installCommand": "cd frontend && npm install",
  "env": {
    "NEXT_PUBLIC_API_URL": "@foodos_api_url",
    "NEXT_PUBLIC_FIREBASE_API_KEY": "@foodos_firebase_api_key",
    "NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN": "@foodos_firebase_auth_domain",
    "NEXT_PUBLIC_FIREBASE_PROJECT_ID": "@foodos_firebase_project_id",
    "NEXT_PUBLIC_FIREBASE_APP_ID": "@foodos_firebase_app_id"
  }
}
